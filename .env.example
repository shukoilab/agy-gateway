# agy-gateway environment template.
#
# Copy to `.env` next to docker-compose.yml, or export these in the unit/systemd environment.
# Every AGY_GW_* key below is read by the gateway; the file's value wins over config.yaml.
# Defaults shown are the code defaults (internal/config/config.go, DefaultConfig).

# ---------------------------------------------------------------- server & network
# PORT/HOST are shell-level aliases, not app settings; AGY_GW_PORT/AGY_GW_HOST win when set.
PORT=8080
AGY_GW_PORT=8080
HOST=0.0.0.0
AGY_GW_HOST=0.0.0.0

# docker compose publishes on this port. Compose-only: the gateway never reads it.
AGY_GW_HOST_PORT=8080

AGY_GW_READ_HEADER_TIMEOUT=10s
AGY_GW_IDLE_TIMEOUT=300s
AGY_GW_SHUTDOWN_DRAIN_TIMEOUT=120s
AGY_GW_MAX_REQUEST_BODY_BYTES=104857600
AGY_GW_SSE_KEEPALIVE_INTERVAL=15s

# ---------------------------------------------------------------- security
AGY_GW_ADMIN_KEY=change-me-admin
AGY_GW_CLIENT_KEY_1=change-me-client

# Comma-separated `key[:rpm]` list; per-key rate limiting applies when rpm is given.
# AGY_GW_CLIENT_KEYS=sk-alpha:120,sk-beta:60

AGY_GW_ALLOWED_CORS_ORIGINS=*

# ---------------------------------------------------------------- tool delegation
# Ceiling on one tool call's JSON arguments.
AGY_GW_MAX_TOOL_ARGUMENT_BYTES=16777216
# Reject arguments that do not match the tool's declared schema.
AGY_GW_STRICT_SCHEMA_VALIDATION=true
# Ceiling on tools a single request may declare.
AGY_GW_MAX_CLIENT_TOOLS=128
# Ceiling on tool calls collected in one turn.
AGY_GW_MAX_INTERCEPTED_TOOL_CALLS=16
# Idle window after a tool call; every streamed chunk re-arms it. On expiry the gateway sends
# session/cancel, then waits one more window of grace before aborting the prompt.
AGY_GW_TOOL_CALL_COLLECT_WINDOW=1s
# Prepend the precedence banner that tells the model to use only the caller's tools.
AGY_GW_STRICT_CLIENT_TOOL_DELEGATION=true

# ---------------------------------------------------------------- worker pool
AGY_GW_POOL_WORKER_COUNT=2
AGY_GW_POOL_ACQUIRE_TIMEOUT=15s
AGY_GW_POOL_HANDSHAKE_TIMEOUT=15s
AGY_GW_POOL_INFERENCE_TIMEOUT=900s
AGY_GW_POOL_FIRST_TOKEN_TIMEOUT=120s
AGY_GW_POOL_MAX_SCANNER_BUFFER_BYTES=134217728
AGY_GW_POOL_MAX_REQUESTS_PER_WORKER=250
AGY_GW_POOL_MAX_WORKER_UPTIME=2h

# ---------------------------------------------------------------- multi-account rotation
AGY_GW_AUTO_ROTATE_ENABLED=true
AGY_GW_MAX_RETRIES=3
AGY_GW_RETRY_INITIAL_BACKOFF=500ms
AGY_GW_RETRY_MAX_BACKOFF=10s
AGY_GW_QUOTA_POLL_INTERVAL=30s
AGY_GW_MIN_REMAINING_QUOTA_PCT=5.0
# round_robin | least_used | sticky. round_robin is the code default.
AGY_GW_ALLOCATION_STRATEGY=round_robin
AGY_GW_CREDENTIAL_OP_TIMEOUT=20s
AGY_GW_AUTH_EXPIRED_RETRY_INTERVAL=5m
AGY_GW_MAX_FAILOVER_RETRIES=3
AGY_GW_DEFAULT_COOLDOWN_5H=30m
AGY_GW_DEFAULT_COOLDOWN_WEEKLY=24h

# ---------------------------------------------------------------- ACP identity & capabilities
# The fingerprint advertised in initialize.clientInfo. `zed` is the verified reference client;
# `gateway` advertises agy-gateway as itself. The version is data, never a code literal.
AGY_GW_IDENTITY_PROFILE=zed
# AGY_GW_IDENTITY_NAME=zed
# AGY_GW_IDENTITY_TITLE=Zed
# AGY_GW_IDENTITY_VERSION=1.30.2+stable.398.610ea4b8de1c6e887f03563f067278002f41256e

# `zed` advertises fs + terminal (the gateway answers both). `sandbox` advertises neither.
# Advertising a capability without its handler stalls the turn, so this is validated at startup.
AGY_GW_CAPABILITIES_PROFILE=zed
# AGY_GW_CAPABILITIES_FS=true
# AGY_GW_CAPABILITIES_TERMINAL=true
# AGY_GW_CAPABILITIES_ELICITATION=true
# AGY_GW_CAPABILITIES_SESSION_METADATA=true

# ---------------------------------------------------------------- provider semantics
AGY_GW_DEFAULT_MODEL=gemini-3.8-flash
AGY_GW_DEFAULT_REASONING_EFFORT=medium
AGY_GW_EXPOSE_REASONING_CONTENT=true
AGY_GW_ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet
AGY_GW_ANTHROPIC_DEFAULT_MAX_TOKENS=4096
AGY_GW_ANTHROPIC_EXPOSE_REASONING_CONTENT=true

# auto forwards image blocks to the agent; reject refuses them provider-natively.
AGY_GW_VISION_MODE=auto
# History budget; enforced by compacting the oldest tool results, keeping every assistant turn.
AGY_GW_MAX_HISTORY_TOKENS=60000
# ignore: accept unrepresentable fields and name them in X-Agy-Ignored-Params.
# reject: answer provider-native invalid_request_error naming the first one.
AGY_GW_UNSUPPORTED_PARAMETER_POLICY=ignore

# Remote image references (http/https) are fetched server-side; this policy bounds them.
AGY_GW_MEDIA_ALLOW_REMOTE=true
AGY_GW_MEDIA_MAX_BYTES=8388608
AGY_GW_MEDIA_FETCH_TIMEOUT=10s
AGY_GW_MEDIA_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp
# Loopback/private/link-local targets are refused unless this is explicitly enabled.
AGY_GW_MEDIA_ALLOW_PRIVATE_HOSTS=false

# ---------------------------------------------------------------- binaries
AGY_GW_AGY_PATH=/usr/local/bin/agy
AGY_GW_AGY_AUTH_PATH=/usr/local/bin/agy-auth
AGY_GW_AGY_MIN_VERSION=1.5.16
AGY_GW_CONFIG_SWITCH_TIMEOUT=10s

# ---------------------------------------------------------------- storage
AGY_GW_BASE_DATA_DIR=/var/lib/agy-gateway
# AGY_GW_VAULT_DIR=/var/lib/agy-gateway/vault-xdg
# AGY_GW_WORKERS_DIR=/var/lib/agy-gateway/workers
# AGY_GW_TMP_DIR=/var/lib/agy-gateway/tmp
# AGY_GW_WORKSPACES_DIR=/var/lib/agy-gateway/workspaces
# Durable workspace every worker runs in. Never cleared on a request path; clear it explicitly with
# `agy-accounts clean --workspace`. Must be under AGY_GW_WORKSPACES_DIR and outside the workers tree.
# AGY_GW_WORKSPACE_DIR=/var/lib/agy-gateway/workspaces/shared

# ---------------------------------------------------------------- outbound proxy (optional)
# AGY_GW_PROXY_ENABLED=false
# AGY_GW_PROXY_HTTP_PROXY=http://proxy.internal:3128
# AGY_GW_PROXY_HTTPS_PROXY=http://proxy.internal:3128
# AGY_GW_PROXY_NO_PROXY=localhost,127.0.0.1

# ---------------------------------------------------------------- auto-updater
AGY_GW_AUTO_UPDATE_ENABLED=true
AGY_GW_AUTO_UPDATE_INTERVAL=6h
AGY_GW_AUTO_UPDATE_ON_STARTUP=true
AGY_GW_AUTO_UPDATE_BIN_DIR=/var/lib/agy-gateway/bin
AGY_GW_AUTO_UPDATE_AGY_ENABLED=true
AGY_GW_AUTO_UPDATE_AGY_AUTH_ENABLED=true

# ---------------------------------------------------------------- observability
AGY_GW_LOG_LEVEL=info
AGY_GW_LOG_FORMAT=json
AGY_GW_METRICS_ENABLED=true
AGY_GW_METRICS_PATH=/metrics

# ---------------------------------------------------------------- external: agy-auth
# Read by the agy-auth CLI, not by the gateway.
AGY_AUTH_NO_UPDATE_CHECK=1
