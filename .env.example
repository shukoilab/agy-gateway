# ==============================================================================
# agy-gateway: 12-Factor Dynamic Configuration Template
# ==============================================================================
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
#
# Environment variables take precedence over config.yaml defaults.
# System environment variables take precedence over .env file declarations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gateway Server Network & Timeouts
# ------------------------------------------------------------------------------
# In-container or local binding port (also responds to standard $PORT)
PORT=8080
AGY_GW_PORT=8080

# External host port mapped by docker-compose (e.g. 8080, 9090, 8888)
AGY_GW_HOST_PORT=8080

# In-container or local listening host (use 0.0.0.0 for containerized / public access)
HOST=0.0.0.0
AGY_GW_HOST=0.0.0.0

# HTTP server timeouts and request body limits
AGY_GW_READ_HEADER_TIMEOUT=15s
AGY_GW_IDLE_TIMEOUT=300s
AGY_GW_SHUTDOWN_DRAIN_TIMEOUT=120s
AGY_GW_MAX_REQUEST_BODY_BYTES=104857600 # 100 MiB (supports 1M+ context & multimodal payloads)
AGY_GW_SSE_KEEPALIVE_INTERVAL=15s

# ------------------------------------------------------------------------------
# 2. Security & Access Control
# ------------------------------------------------------------------------------
# Admin control plane master secret (required for /admin/v1/* endpoints)
AGY_GW_ADMIN_KEY=admin-super-secret-key-change-me

# Primary client API key for OpenAI-compatible endpoints (/v1/*)
AGY_GW_CLIENT_KEY_1=sk-antigravity-dev-test

# Optional multi-key client declarations with rate limits (format: key:rpm,key2:rpm)
# AGY_GW_CLIENT_KEYS=sk-client-alpha:120,sk-client-beta:60

# Allowed CORS origins (comma-separated, or "*" to permit all origins)
AGY_GW_ALLOWED_CORS_ORIGINS=*

# Allow remote image URLs in multimodal OpenAI message payloads
AGY_GW_ALLOW_REMOTE_IMAGE_URLS=true

# Maximum client tool argument bytes (16 MiB default for 1M context payloads)
AGY_GW_MAX_TOOL_ARGUMENT_BYTES=16777216

# ------------------------------------------------------------------------------
# 3. Antigravity ACP Worker Pool Engine
# ------------------------------------------------------------------------------
# Number of concurrent warm agy acp child workers to maintain in memory
AGY_GW_POOL_WORKER_COUNT=2

# Pool lifecycle timeouts (optimized for 1M context prefill and generation)
AGY_GW_POOL_ACQUIRE_TIMEOUT=30s
AGY_GW_POOL_HANDSHAKE_TIMEOUT=15s
AGY_GW_POOL_INFERENCE_TIMEOUT=900s # 15 minutes for 1M context prefill and deep reasoning
AGY_GW_POOL_FIRST_TOKEN_TIMEOUT=120s # 2 minutes TTFT headroom for 1M token cold cache
AGY_GW_POOL_MAX_SCANNER_BUFFER_BYTES=134217728 # 128 MiB IPC pipe streaming buffer

# Worker recycling policies (0 = disable limit)
AGY_GW_POOL_MAX_REQUESTS_PER_WORKER=200
AGY_GW_POOL_MAX_WORKER_UPTIME=24h

# ------------------------------------------------------------------------------
# 4. Multi-Account Rotation & Smart Failover
# ------------------------------------------------------------------------------
# Enable automatic failover and rotation across multiple Google accounts
AGY_GW_AUTO_ROTATE_ENABLED=true

# General maximum retries for 3rd-party interactions (agy, agy-auth, failover)
AGY_GW_MAX_RETRIES=3

# Initial and maximum backoff duration for exponential jitter retry
AGY_GW_RETRY_INITIAL_BACKOFF=500ms
AGY_GW_RETRY_MAX_BACKOFF=10s

# Quota polling interval for background account health discovery
AGY_GW_QUOTA_POLL_INTERVAL=60s

# Minimum quota percentage threshold before proactively rotating to another account
AGY_GW_MIN_REMAINING_QUOTA_PCT=5.0

# Maximum failover retry attempts before returning 429/503 to the client (alias to MAX_RETRIES)
AGY_GW_MAX_FAILOVER_RETRIES=3

# ------------------------------------------------------------------------------
# 5. OpenAI Model Emulation & Reasoning
# ------------------------------------------------------------------------------
# Default model returned when client specifies unversioned "gemini" or "default"
AGY_GW_DEFAULT_MODEL=gemini-3.8-flash

# Default reasoning effort when omitted by client: "low", "medium", "high"
AGY_GW_DEFAULT_REASONING_EFFORT=medium

# Expose thinking tokens in stream as OpenAI delta.reasoning_content
AGY_GW_EXPOSE_REASONING_CONTENT=true

# Policy for unsupported OpenAI parameters: "strip_and_warn" or "reject"
AGY_GW_UNSUPPORTED_PARAM_POLICY=strip_and_warn

# ------------------------------------------------------------------------------
# 5b. Anthropic Messages API Configuration
# ------------------------------------------------------------------------------
# Default model for Anthropic /v1/messages endpoint
AGY_GW_ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet

# Default max_tokens ceiling when omitted by client
AGY_GW_ANTHROPIC_DEFAULT_MAX_TOKENS=4096

# Expose reasoning trace in Anthropic thinking content blocks
AGY_GW_ANTHROPIC_EXPOSE_REASONING_CONTENT=true

# ------------------------------------------------------------------------------
# 5c. Optional Outbound HTTP/HTTPS Proxy (Docker Layer & Container Egress)
# ------------------------------------------------------------------------------
# All outgoing requests from agy-gateway, agy acp, agy-auth, and models.dev will
# route through this proxy when set. Supports optional basic auth (user:pass).
# Standard Docker / Linux environment variables:
# HTTP_PROXY=http://user:password@proxy-host:3128
# HTTPS_PROXY=http://user:password@proxy-host:3128
# NO_PROXY=localhost,127.0.0.1,::1,agy-net,agy-gateway,.local
#
# Alternatively configurable via AGY_GW_PROXY_* flags:
# AGY_GW_PROXY_ENABLED=false
# AGY_GW_PROXY_HTTP_PROXY=http://user:password@proxy-host:3128
# AGY_GW_PROXY_HTTPS_PROXY=http://user:password@proxy-host:3128
# AGY_GW_PROXY_NO_PROXY=localhost,127.0.0.1,::1,agy-net,agy-gateway

# ------------------------------------------------------------------------------
# 6. Observability & Logging
# ------------------------------------------------------------------------------
# Log level: "debug", "info", "warn", "error"
AGY_GW_LOG_LEVEL=info

# Structured log format: "json" or "text"
AGY_GW_LOG_FORMAT=json

# Prometheus-compatible metrics endpoint toggle
AGY_GW_METRICS_ENABLED=true
AGY_GW_METRICS_PATH=/metrics

# ------------------------------------------------------------------------------
# 7. Underlying Binaries & Runtime Variables
# ------------------------------------------------------------------------------
# Disable upstream auto-update checks during headless execution
AGY_AUTH_NO_UPDATE_CHECK=1
